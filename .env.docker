# ============================================================
# TradingAgents — Docker .env
# cp .env.docker .env  (on the deployment server)
# ============================================================

ENVIRONMENT=production

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
# The administrator account is not configured here. On the first visit the UI
# serves a one-time setup screen that registers the Server Owner.

# --- Database role separation ---
# DB_PASSWORD belongs only to the PostgreSQL owner/migration service.
# DB_RUNTIME_PASSWORD belongs to the non-owner/NOBYPASSRLS web+worker role.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=replace-with-a-long-random-migration-password
DB_RUNTIME_PASSWORD=replace-with-a-different-long-random-runtime-password

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS (Docker frontend port) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# --- Redis (enabled for Docker multi-service) ---
REDIS_URL=redis://redis:6379/0
ANALYSIS_QUEUE_MODE=worker

# --- Optional ---
# METRICS_TOKEN=
# MAX_REQUEST_BODY_BYTES=2000000

APP_TIMEZONE=UTC
