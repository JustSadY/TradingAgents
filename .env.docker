# ============================================================
# TradingAgents — Docker .env
# cp .env.docker .env  (on the deployment server)
# ============================================================

ENVIRONMENT=production

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
ADMIN_USERNAME=admin
# python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- Database (single source for both PostgreSQL and backend) ---
# python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=replace-with-a-long-random-password

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS (Docker frontend port) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# --- Redis (enabled for Docker multi-service) ---
REDIS_URL=redis://redis:6379/0
ANALYSIS_QUEUE_MODE=worker

# --- Optional ---
# METRICS_TOKEN=
# MAX_REQUEST_BODY_BYTES=2000000
