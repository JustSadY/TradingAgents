# ============================================================
# TradingAgents — .env örneği
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# cp .env.example .env
# ============================================================

# --- Environment ---
# Set to "production" to refuse booting with insecure default secrets
# (SECRET_KEY / ENCRYPTION_KEY / ADMIN_PASSWORD_HASH must then be provided).
ENVIRONMENT=development

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
ADMIN_USERNAME=admin
# python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@localhost:5432/tradingagents

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Vector memory (episodic + inter-agent Q&A) ---
# Memory is DISABLED unless PINECONE_API_KEY is set (no fallback by design).
PINECONE_API_KEY=
PINECONE_INDEX=tradingagents-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Embedder: "pinecone" = hosted/server-side (no extra key); "openai" = client-side.
MEMORY_EMBEDDER=pinecone
PINECONE_EMBED_MODEL=llama-text-embed-v2
# Only needed when MEMORY_EMBEDDER=openai:
MEMORY_OPENAI_API_KEY=
MEMORY_OPENAI_EMBED_MODEL=text-embedding-3-small

# ============================================================
# Web UI Configured Settings (Do NOT put in .env)
# ============================================================
# All LLM Keys (OpenAI, Anthropic, Gemini, DeepSeek, etc.)
# and Data Providers (Reddit, AlphaVantage, Searxng) are now
# configured directly in the application's Web UI:
# - User API keys: Preferences -> Account & API Keys
# - Global settings: Admin Panel -> Global Settings
# ============================================================


