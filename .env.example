# ============================================================
# TradingAgents — .env örneği
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# cp .env.example .env
# ============================================================

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
ADMIN_USERNAME=admin
# python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@localhost:5432/tradingagents

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================
# Web UI Configured Settings (Do NOT put in .env)
# ============================================================
# All LLM Keys (OpenAI, Anthropic, Gemini, DeepSeek, etc.)
# and Data Providers (Reddit, AlphaVantage, Searxng) are now
# configured directly in the application's Web UI:
# - User API keys: Preferences -> Account & API Keys
# - Global settings: Admin Panel -> Global Settings
# ============================================================

# ============================================================
# TradingAgents Konfigürasyonu (Opsiyonel)
# ============================================================
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_LLM_MODEL=gpt-4o-mini
# TRADINGAGENTS_OUTPUT_LANGUAGE=Turkish
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_DISCUSS_ROUNDS=1
# TRADINGAGENTS_ANALYST_CONCURRENCY_LIMIT=2
# TRADINGAGENTS_INCLUDE_HISTORICAL_ANALYSES=false
# TRADINGAGENTS_HISTORICAL_ANALYSES_LIMIT=5
# TRADINGAGENTS_ANALYST_MODELS={"market":"google:gemini-2.5-flash","news":"deep"}
