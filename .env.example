# ============================================================
# TradingAgents — .env örneği
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# cp .env.example .env
# ============================================================

# --- Environment ---
# Set to "production" to refuse booting with insecure default secrets
# (SECRET_KEY / ENCRYPTION_KEY must then be provided).
ENVIRONMENT=development

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
# The administrator account is not configured here. While the database has no
# users the UI serves a one-time setup screen that registers the Server Owner.

# --- Database ---
# For Docker use host=postgres instead of localhost:
#   DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@postgres:5432/tradingagents
DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@localhost:5432/tradingagents
# Production hardening: after the application uses a dedicated non-owner,
# NOBYPASSRLS runtime role, enable this to fail startup if RLS can be bypassed.
# RLS_STRICT_MODE=false

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS ---
# For Docker: CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Public frontend URL (optional) ---
# Used only while building the frontend image to create shareable report links
# behind a reverse proxy. Leave blank for localhost/development, where the
# browser's current origin is used. Example: https://trading.example.com
VITE_PUBLIC_APP_URL=

# --- Horizontal scaling (optional) ---
# When REDIS_URL is set, analysis WebSocket events fan out over Redis pub/sub
# and the task registry becomes visible across processes. Leave empty for the
# default single-process deployment (no Redis needed).
# REDIS_URL=redis://localhost:6379/0
# "inline" (default) runs analyses inside the web process. "worker" enqueues
# them onto arq — requires REDIS_URL and a worker process:
#   arq backend.worker.WorkerSettings
# ANALYSIS_QUEUE_MODE=inline
# For Docker: REDIS_URL=redis://redis:6379/0 + ANALYSIS_QUEUE_MODE=worker

# --- HTTP limits (optional) ---
# Maximum accepted request body size in bytes (default 2000000 = 2 MB, 0 disables).
# MAX_REQUEST_BODY_BYTES=2000000

# Only set this to true if a reverse proxy YOU control sits in front of this
# app and overwrites (not appends to) X-Forwarded-For. Pair it with the exact
# CIDRs of that proxy; otherwise request.client.host is the only IP a client
# can't spoof for rate limiting.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8

# --- Server-managed Ollama (optional) ---
# Ollama has no per-user API key. Set this only when the backend should use a
# trusted local/reverse-proxied Ollama server; tenants cannot override it.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Real-money trading (disabled by default) ---
# Alpaca paper trading remains available to the Server Owner. Set this to
# true only after an operator has intentionally reviewed the live-broker
# credentials and risk controls. A database/UI setting alone cannot enable
# real-money orders.
# IANA timezone used for user cron schedules (stock trade dates still use America/New_York)
APP_TIMEZONE=UTC

# --- Exchange calendar ---
# exchange_calendars code used for tickers with no venue suffix (AAPL, MSFT).
# Suffixed tickers pick their own venue (THYAO.IS -> XIST, VOD.L -> XLON), and
# crypto is never gated. Scheduled scans and automated orders are skipped while
# the resolved exchange is closed.
# DEFAULT_EXCHANGE_CALENDAR=XNYS

# ENABLE_LIVE_TRADING=false

# --- System logs (optional) ---
# Minimum level persisted to the in-app System Logs page (system_logs table).
# DEBUG | INFO (default) | WARNING | ERROR | CRITICAL
# SYSTEM_LOG_DB_LEVEL=INFO
# How many days of System Logs to keep. The daily maintenance job deletes rows
# older than this. Set to 0 to keep everything (the table then grows without
# bound — one analysis writes hundreds of INFO rows).
# SYSTEM_LOG_RETENTION_DAYS=14

# --- Observability (optional) ---
# Bearer token for the Prometheus scrape endpoint GET /metrics.
# Leave empty to keep the endpoint disabled (returns 404).
# python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=

# Install optional tracing packages with:
#   cd backend && uv sync --group observability
#
# Standard OTLP exporter:
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=tradingagents-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# Langfuse LLM/agent tracing. Keep OTEL_ENABLED=false when using the in-process
# Langfuse callback; use an OpenTelemetry Collector for multi-destination fanout.
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Note: vector memory (Pinecone) is configured PER USER in the app's Settings UI
# (Pinecone API key, index, embedder, models) — there are no server-level
# memory env vars.

# ============================================================
# Web UI Configured Settings (Do NOT put in .env)
# ============================================================
# All LLM Keys (OpenAI, Anthropic, Gemini, DeepSeek, etc.)
# and Data Providers (Reddit, AlphaVantage, Searxng) are now
# configured directly in the application's Web UI:
# - User API keys: Preferences -> Account & API Keys
# - Global settings: Admin Panel -> Global Settings
# ============================================================
