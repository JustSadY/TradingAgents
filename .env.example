# ============================================================
# TradingAgents — .env örneği
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# cp .env.example .env
# ============================================================

# --- Environment ---
# Set to "production" to refuse booting with insecure default secrets
# (SECRET_KEY / ENCRYPTION_KEY / ADMIN_PASSWORD_HASH must then be provided).
ENVIRONMENT=development

# --- Auth ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-character-string
ADMIN_USERNAME=admin
# python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- Database ---
# For Docker use host=postgres instead of localhost:
#   DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@postgres:5432/tradingagents
DATABASE_URL=postgresql+asyncpg://tradingagents:tradingagents@localhost:5432/tradingagents

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS ---
# For Docker: CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Horizontal scaling (optional) ---
# When REDIS_URL is set, analysis WebSocket events fan out over Redis pub/sub
# and the task registry becomes visible across processes. Leave empty for the
# default single-process deployment (no Redis needed).
# REDIS_URL=redis://localhost:6379/0
# "inline" (default) runs analyses inside the web process. "worker" enqueues
# them onto arq — requires REDIS_URL and a worker process:
#   arq backend.worker.WorkerSettings
# ANALYSIS_QUEUE_MODE=inline
# For Docker: REDIS_URL=redis://redis:6379/0 + ANALYSIS_QUEUE_MODE=worker

# --- HTTP limits (optional) ---
# Maximum accepted request body size in bytes (default 2000000 = 2 MB, 0 disables).
# MAX_REQUEST_BODY_BYTES=2000000

# Only set this to true if a reverse proxy YOU control sits in front of this
# app and overwrites (not appends to) X-Forwarded-For. Otherwise leave unset —
# request.client.host is the only IP a client can't spoof for rate limiting.
# TRUST_PROXY_HEADERS=false

# --- Server-managed Ollama (optional) ---
# Ollama has no per-user API key. Set this only when the backend should use a
# trusted local/reverse-proxied Ollama server; tenants cannot override it.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Real-money trading (disabled by default) ---
# Alpaca paper trading remains available to the Server Owner.  Set this to
# true only after an operator has intentionally reviewed the live-broker
# credentials and risk controls.  A database/UI setting alone cannot enable
# real-money orders.
# ENABLE_LIVE_TRADING=false

# --- Observability (optional) ---
# Bearer token for the Prometheus scrape endpoint GET /metrics.
# Leave empty to keep the endpoint disabled (returns 404).
# python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=

# Required by docker-compose.yml when the bundled Grafana service is started.
# Generate a long, unique password; monitoring ports bind to localhost by
# default and should be exposed remotely only through an authenticated proxy.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Note: vector memory (Pinecone) is configured PER USER in the app's Settings UI
# (Pinecone API key, index, embedder, models) — there are no server-level
# memory env vars.

# ============================================================
# Web UI Configured Settings (Do NOT put in .env)
# ============================================================
# All LLM Keys (OpenAI, Anthropic, Gemini, DeepSeek, etc.)
# and Data Providers (Reddit, AlphaVantage, Searxng) are now
# configured directly in the application's Web UI:
# - User API keys: Preferences -> Account & API Keys
# - Global settings: Admin Panel -> Global Settings
# ============================================================
